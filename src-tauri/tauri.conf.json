{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panopin",
  "version": "1.4.0",
  "identifier": "com.mehmetburaktaskaya.panopin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "shelf",
        "title": "Panopin",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://media.localhost media:; media-src http://media.localhost media:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Mehmet Burak Taşkaya",
    "publisher": "Mehmet Burak Taşkaya",
    "homepage": "https://github.com/MehmetBurakTaskaya/panopin",
    "license": "MIT",
    "shortDescription": "Clipboard and screenshot shelf",
    "longDescription": "Saves what you copy and the screenshots you take, and slides them in on a cork board when you need them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German", "Spanish", "French", "Italian", "PortugueseBR", "Turkish", "Russian", "Arabic", "Japanese", "Korean", "SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMjlFRTUwOEY1MjQwNjAKUldSZ1FGS1BVTzRwcXU5QVU2UTZuNXdRUTFsYjdpWDRzRkRJUnNvbFlIdXgxbjZYWDBZRHkvb0UK",
      "endpoints": ["https://github.com/MehmetBurakTaskaya/panopin/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
