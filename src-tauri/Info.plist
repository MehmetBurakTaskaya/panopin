<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app's Info.plist. The languages Panopin speaks (locales/), so the
     panels and alerts macOS draws for it use the user's language too (D-074). -->
<plist version="1.0">
<dict>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
    <string>es</string>
    <string>fr</string>
    <string>pt-BR</string>
    <string>tr</string>
    <string>ru</string>
    <string>ja</string>
    <string>ko</string>
    <string>zh-Hans</string>
  </array>
</dict>
</plist>
