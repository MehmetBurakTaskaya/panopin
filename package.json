{
  "name": "panopin",
  "private": true,
  "version": "1.5.1",
  "description": "Clipboard and screenshot shelf for Windows and macOS, styled as a cork board.",
  "license": "MIT",
  "author": "Mehmet Burak Taşkaya",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:licenses": "node scripts/check-npm-licenses.mjs",
    "check:third-party": "node scripts/third-party.mjs --check",
    "third-party": "node scripts/third-party.mjs",
    "icons": "node scripts/icons.mjs",
    "stats": "node scripts/stats.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.20",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
